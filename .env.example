# Production configuration example. Never commit an actual .env or credentials.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=uniflow.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://uniflow.example.uz
# Supply DJANGO_SECRET_KEY through your secret manager.
# Telegram is optional. Use a secret manager or the ignored private token file.
# UNIFLOW_TELEGRAM_TOKEN is also supported; never paste a token into this file.
# UNIFLOW_TELEGRAM_CHAT_ID is a nonsecret private-chat destination.
