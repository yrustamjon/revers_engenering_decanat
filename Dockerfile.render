# syntax=docker/dockerfile:1
FROM node:22-alpine AS frontend-build
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_DEBUG=0 \
    DJANGO_TRUST_PROXY=1 \
    DJANGO_STATIC_ROOT=/var/lib/uniflow/static \
    DJANGO_MEDIA_ROOT=/var/lib/uniflow/media \
    DJANGO_FRONTEND_ROOT=/app/frontend \
    DJANGO_UPLOADS_ENABLED=0
WORKDIR /app/backend
COPY backend/requirements.txt ./requirements.txt
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    pip install --no-cache-dir -r requirements.txt \
    && groupadd --gid 10001 uniflow \
    && useradd --uid 10001 --gid 10001 --no-create-home uniflow \
    && mkdir -p /var/lib/uniflow/static /var/lib/uniflow/media \
    && chown -R uniflow:uniflow /var/lib/uniflow
COPY --chown=uniflow:uniflow backend/ ./
COPY --from=frontend-build /build/frontend/dist/ /app/frontend/
COPY --chown=uniflow:uniflow deploy/render-entrypoint.sh /app/render-entrypoint.sh
USER uniflow
EXPOSE 10000
ENTRYPOINT ["/bin/sh", "/app/render-entrypoint.sh"]
